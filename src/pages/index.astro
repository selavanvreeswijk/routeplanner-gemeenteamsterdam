---
import data from "../cbadataset.json" with { type: "json" };
import { filterGroups } from "../../scripts/filtergroups.js";
import { countFilter } from "../../scripts/filtering.js";

import Header from "../components/Header.astro";
import Filter from "../components/Filter.astro";
import LocationFilter from "../components/LocationFilter.astro";
import Display from "../components/Display.astro";
import LocationCard from "../components/LocationCard.astro";
import Map from "../components/Map.astro";

const locations = data.features.map((feature) => ({
  name: feature.properties.Naam_locatie,
  address: `${feature.properties.adres} ${feature.properties.Huisnummer}`,
  hoofdfilter: feature.properties.Hoofdfilter.trim(),
  subfilter: feature.properties.Subfilter.trim(),
  counts: countFilter(feature, filterGroups),
  lat: feature.geometry.coordinates[1],
  lng: feature.geometry.coordinates[0],
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="styles/global.css" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <title>TAVI</title>
  </head>
  <body>
    <div class="app-wrapper">
      <Header />
      <div class="content-area">
        <div class="content-left">
          <Filter />
          <LocationFilter />
          <Display />
          <div id="list-view">
            <LocationCard locations={locations} />
          </div>
        </div>
        <script is:inline define:vars={{ locations }}>
          window._locaties = locations;
        </script>
        <Map />
      </div>
    </div>
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>
  </body>

  <style>
    /* ── Mobiel & tablet */
    .content-area {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .content-left {
      display: flex;
      flex-direction: column;
    }

    /* ── Desktop (1024px+) */
    @media (min-width: 1024px) {
      .app-wrapper {
        height: 100vh;
        overflow: hidden;
      }

      .content-area {
        flex-direction: row;
        flex: 1;
        overflow: hidden;
      }

      .content-left {
        width: clamp(340px, 38%, 550px);
        overflow-y: auto;
        border-right: 1px solid var(--ams-color-grey-2);
        flex-shrink: 0;
      }

      /* :global() nodig want #map-view en #list-view komen uit andere components */
      /* Bron Astro global: https://docs.astro.build/en/guides/styling/#global-styles */
      :global(#map-view) {
        display: flex !important;
        flex: 1;
        flex-direction: column;
      }

      :global(#list-view) {
        display: block !important;
      }
    }
  </style>

  <script>
    // @ts-nocheck

    // Onboarding ------------------------------------------------------

    const opgeslagenProfiel = localStorage.getItem("profiel");
    const opgeslagenNaam = localStorage.getItem("naam");

    const isOnboarding = window.location.pathname.includes("onboarding");
    if (!opgeslagenProfiel || (!opgeslagenNaam && !isOnboarding)) {
      window.location.href = import.meta.env.BASE_URL + "onboarding";
    } else {
      // Tweede bezoek: zet het opgeslagen profiel alvast aan in de filterknop
      const profielObject = Object.keys(JSON.parse(opgeslagenProfiel));

      profielObject.forEach((waarde) => {
        const checkbox = document.querySelector(
          `input[name="filter"][value="${waarde}"]`,
        );
        console.log("checkbox:", checkbox);
        if (checkbox) {
          checkbox.checked = true;
          // Bron events: https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/dispatchEvent
          checkbox.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    }

    const input = document.getElementById("search-input");
    const cards = document.querySelectorAll(".location-list li");
    const countEl = document.getElementById("location-count");

    function updateCount() {
      const visible = Array.from(cards).filter(
        (c) => c.style.display !== "none",
      ).length;
      if (countEl)
        countEl.textContent = `${visible} locatie${visible === 1 ? "" : "s"} gevonden`;
    }

    updateCount();

    // Bron <mark>: https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/mark
    // Bron regex replace: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/replace
    function highlight(text: string, query: string): string {
      if (!query) return text;
      const regex = new RegExp(
        `(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`,
        "gi",
      );
      return text.replace(regex, `<mark>$1</mark>`);
    }

    input.addEventListener("input", () => {
      const query = input.value.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.dataset.name ?? "";
        const address = card.dataset.address ?? "";
        const matches = name.includes(query) || address.includes(query);
        card.style.display = matches ? "" : "none";
        if (matches) visibleCount++;

        // Highlight in naam
        const h2 = card.querySelector("h2");
        if (h2) {
          const originalName = h2.dataset.original ?? h2.textContent ?? "";
          h2.dataset.original = originalName;
          h2.innerHTML = query ? highlight(originalName, query) : originalName;
        }
      });

      updateCount();
      (window as any).filterMarkers?.(query);
    });

    // toggle tussen lijst en kaartweergave
    const radioLijst = document.getElementById("radio-1");
    const radioMap = document.getElementById("radio-2");
    const listView = document.getElementById("list-view");
    const mapView = document.getElementById("map-view");
    const zoekKnop = document.getElementById(
      "search-input-btn",
    ) as HTMLButtonElement;

    if (zoekKnop) zoekKnop.style.display = "none";

    if (zoekKnop) {
      zoekKnop.addEventListener("click", () => {
        (window as any).zoekOpKaart?.(input.value.trim());
      });
    }

    input.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" && zoekKnop && zoekKnop.style.display !== "none") {
        (window as any).zoekOpKaart?.(input.value.trim());
      }
    });

    // Locatie Filter balk -- ZORGT ERVOOR DAT DE LOCATIES IN DE LIJST EN OP DE KAART FILTEREN
    // --- haalt ids uit de LocationFilter
    const hoofdfilterSelect = document.getElementById("hoofdfilter-select");
    const subfilterSelect = document.getElementById("subfilter-select");

    function filterCards() {
      const hoofdfilter = hoofdfilterSelect.value.trim().toLowerCase();
      const subfilter = subfilterSelect.value.trim().toLowerCase();

      cards.forEach((card) => {
        const cardHoofd = card.dataset.hoofdfilter ?? "";
        const cardSub = card.dataset.subfilter ?? "";
        const matchHoofd = !hoofdfilter || cardHoofd === hoofdfilter;
        const matchSub = !subfilter || cardSub === subfilter;
        card.style.display = matchHoofd && matchSub ? "" : "none";
      });

      updateCount();
    }

    hoofdfilterSelect.addEventListener("change", filterCards);
    subfilterSelect.addEventListener("change", filterCards);

    radioMap.addEventListener("change", () => {
      listView!.style.display = "none";
      mapView!.style.display = "block";
      if (zoekKnop) zoekKnop.style.display = "";
      setTimeout(() => {
        if (window.initialiseerKaart) {
          window.initialiseerKaart();
        }
      }, 50);
    });

    radioLijst.addEventListener("change", () => {
      listView!.style.display = "block";
      mapView!.style.display = "none";
      if (zoekKnop) zoekKnop.style.display = "none";
    });

    // Op desktop (≥1024px) kaart automatisch initialiseren naast de lijst
    if (window.innerWidth >= 1024) {
      setTimeout(() => {
        if (window.initialiseerKaart) {
          window.initialiseerKaart();
        }
      }, 100);
    }
  </script>
</html>
