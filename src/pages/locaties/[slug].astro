---
import cbaData from "../../cbadataset.json";
import Header from "../../components/Header.astro";
// leaflet CSS wordt geladen via <link> in de <head>
import "../../styles/global.css";

export async function getStaticPaths() {
  // maakt paginas aan voor astro build, op basis van de locaties in de JSON
  return cbaData.features.map((feature) => ({
    // Loopt door elke locatie in de JSON en maak voor elke locatie een pagina aan
    params: {
      slug: feature.properties.Naam_locatie.toLowerCase()
        .replace(/\s+/g, "-")
        .replace(/[^a-z0-9-]/g, ""), // Maakt een slug, vervangt streepjes en speciale tekens
    },
    props: { feature }, // Stuurt de data van die locatie mee naar de pagina
  }));
}

const { feature } = Astro.props;
const p = feature.properties;
const lat = feature.geometry.coordinates[1];
const lng = feature.geometry.coordinates[0];

// Toegankelijkheidsinformatie verzamelen en sorteren
const toegankelijkheidItems = [
  // Maakt een lijst van toegankelijkheidskenmerken met label en waarde + een icon van de gemeente amsterdam, filtert lege waarden eruit
  {
    label: "Gehandicapten parkeerplaatsen",
    value: p.Gehandicaptenparkeerplaatsen_binnen_100_m_,
  },
  { label: "Voorrijden toegestaan", value: p.Voorrijden_toegestaan },
  { label: "Toegankelijk gebouw", value: p.Toegankelijk_gebouw },
  { label: "Assistentiehond toegestaan", value: p.Assistentiehond_toegestaan },
  { label: "Persoonlijke assistent", value: p.Persoonlijke_assistent },
  { label: "Rustplekken", value: p.Rustplekken },
  { label: "Trappen met leuning entree", value: p.Trappen_met_leuning_entree },
  { label: "Aantal traptreden", value: p.Aantal_traptreden },
  {
    label: "Toegankelijke lift",
    value: p.Toegankelijke_lift,
    icon: "/public/assets/toegankelijke-lift-icon.svg",
  },
  {
    label: "Drempelvrije ingang / hellend vlak",
    value:
      p.Toegang_zonder_drempels_en_treden_worden_overbrugd_door_een_hellend_vlak,
  },
  {
    label: "Drempelloos gebouw",
    value: p.Drempelloos_gebouw_en_doorgangen_zijn_voldoende_breed,
  },
  { label: "Rolstoelvriendelijk toilet", value: p.Rolstoelvriendelijk_toilet },
  { label: "Mobiele pin", value: p.Mobiele_pin },
  {
    label: "Toeschouwersplaatsen rolstoelgebruikers",
    value: p.Speciale_toeschouwersplaatsen_rolstoelgebruikers,
  },
  {
    label: "Restaurant tafels onderrijdbaar",
    value: p.Restaurant_tafels_onderrijdbaar,
  },
  { label: "Toegankelijke hotelkamers", value: p.Toegankelijke_hotelkamers },
  { label: "Toegankelijke kleedkamer", value: p.Toegankelijke_kleedkamer },
  { label: "Toegankelijke douche", value: p.Toegankelijke_douche },
  {
    label: "Geleidelijnen en vloermarkeringen",
    value: p.Geleidelijnen_en_vloermarkeringen,
  },
  {
    label: "Audiodescriptie of beeldbeschrijving",
    value: p.Audiodescriptie_of_beeldbeschrijving,
  },
  { label: "Toegankelijke afdruk", value: p.Toegankelijke_afdruk },
  { label: "Materiaal in braille", value: p.Materiaal_in_braille },
  { label: "Zintuigelijke beleving", value: p.Zintuigelijke_beleving },
  { label: "Open ondertiteling", value: p.Open_ondertiteling },
  { label: "Gesloten ondertiteling", value: p.Gesloten_ondertiteling },
  { label: "Tolk gebarentaal", value: p.Tolk_gebarentaal },
  {
    label: "Ringleiding voor slechthorenden",
    value: p.Ringleiding_voor_slechthorenden,
  },
  { label: "Prikkelarme ruimte", value: p.Prikkelarme_ruimte },
  { label: "Prikkelarme uren", value: p.Prikkelarme_uren },
  {
    label: "Herkenning Sunflower Keycord",
    value: p.Herkenning_Sunflower_Keycord,
  },
].filter((i) => i.value !== undefined && i.value !== null); // Filtert kenmerken zonder waarde eruit

const volgorde = (v: string) => (v === "Ja" ? 0 : v === "Nee" ? 1 : 2); // Zorgt dat "Ja" bovenaan komt, "Nee" daaronder en "Onbekend" onderaan
const gesorteerdeItems = toegankelijkheidItems.sort(
  (a, b) => volgorde(a.value) - volgorde(b.value),
); // Sorteert de items op basis van die volgorde
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{p.Naam_locatie}</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body>
    <div class="app-wrapper">
      <Header showSearch={false} />

      <div class="split-view">
        <div class="info-panel">
          <a class="back" href="/">← Terug</a>

          <!-- Naam & adres, met rode linkerbalk -->
          <div class="location-information">
            <p class="category">{p.Subfilter?.trim()}</p>
            <h2>{p.Naam_locatie}</h2>
            <p class="adres">
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M13.772 4.21855C15.9931 6.51565 15.9931 10.2198 13.772 12.5169L9.75017 16.6669L5.72827 12.5177C3.50724 10.2206 3.50724 6.51649 5.72827 4.21938C6.7917 3.11921 8.23952 2.50028 9.75 2.50012C11.2604 2.49996 12.7084 3.11861 13.772 4.21855Z"
                  stroke="black"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12.0249 8.00927C12.0101 9.2942 10.9851 10.3251 9.73232 10.315C8.4794 10.305 7.47025 9.25779 7.47512 7.97271C7.47998 6.68765 8.49698 5.64852 9.7499 5.64844C11.0137 5.65624 12.0321 6.7131 12.0249 8.00927Z"
                  stroke="black"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              {p.adres}
              {p.Huisnummer}
              {p.Postcode}
            </p>
          </div>

          <div class="acties">
            <a href={`tel:${p.Telefoonnummer}`} class="actie-knop-rood">
              <svg
                width="18px"
                height="18px"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="feather feather-phone-call"
              >
                <path
                  d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7
             2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
              Bel
            </a>

            <button class="actie-knop" id="deel-knop">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="18"
                  cy="5"
                  r="3"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <circle
                  cx="6"
                  cy="12"
                  r="3"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <circle
                  cx="18"
                  cy="19"
                  r="3"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <path
                  d="M8.59 13.51L15.42 17.49M15.41 6.51L8.59 10.49"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path>
              </svg>
              Delen
            </button>
          </div>

          <!-- Toegankelijkheidsinformatie als 2-koloms raster -->
          <div class="toegankelijkheid">
            <h3>Toegankelijkheid</h3>
            <ul class="toegankelijkheid-grid">
              {
                gesorteerdeItems
                  .filter((i) => i.value !== "Onbekend")
                  .map((i) => (
                    <li class={i.value === "Ja" ? "item-ja" : "item-nee"}>
                      {i.icon ? (
                        <svg
                          width="40"
                          height="40"
                          viewBox="0 0 20 20"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <Fragment set:html={i.icon} />
                        </svg>
                      ) : (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          {i.value === "Ja" && (
                            <path
                              d="M20 6L9 17L4 12"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          )}
                          {i.value === "Nee" && (
                            <>
                              <path
                                d="M18 6L6 18"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                              />
                              <path
                                d="M6 6L18 18"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                              />
                            </>
                          )}
                        </svg>
                      )}
                      <span>
                        <strong>{i.label}</strong>
                      </span>
                    </li>
                  ))
              }
            </ul>

            {
              gesorteerdeItems.filter((i) => i.value === "Onbekend").length >
                0 && (
                <>
                  <h3>Informatie onbekend</h3>
                  <ul class="toegankelijkheid-grid">
                    {gesorteerdeItems
                      .filter((i) => i.value === "Onbekend")
                      .map((i) => (
                        <li class="item-onbekend">
                          {i.icon ? (
                            <svg
                              width="40"
                              height="40"
                              viewBox="0 0 20 20"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <Fragment set:html={i.icon} />
                            </svg>
                          ) : (
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <circle
                                cx="12"
                                cy="12"
                                r="10"
                                stroke="currentColor"
                                stroke-width="2"
                              />
                              <path
                                d="M12 8v4M12 16h.01"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                              />
                            </svg>
                          )}
                          <span>
                            <strong>{i.label}</strong>
                          </span>
                        </li>
                      ))}
                  </ul>
                </>
              )
            }
          </div>

          <!-- De kaart -->
          <div class="map-panel">
            <div id="map"></div>
          </div>
        </div>
      </div>

      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline
      ></script>
      <script define:vars={{ lat, lng, naam: p.Naam_locatie }} is:inline>
        // Kaart initialiseren na volledig laden van de layout
        // Zelfde aanpak als Map.astro: wacht op window load zodat container de juiste afmetingen heeft
        // Bron invalidateSize: https://leafletjs.com/reference.html#map-invalidatesize
        window.addEventListener("load", function () {
          var map = L.map("map").setView([lat, lng], 15);
          L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);

          // Rode SVG pin drop in Amsterdam-huisstijlkleur
          // Bron L.divIcon: https://leafletjs.com/reference.html#divicon
          var rodePin = L.divIcon({
            html: `<svg width="28" height="40" viewBox="0 0 28 40" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 0C6.268 0 0 6.268 0 14c0 9.333 14 26 14 26S28 23.333 28 14C28 6.268 21.732 0 14 0z"
              fill="#EC0000" stroke="white" stroke-width="1.5"/>
            <circle cx="14" cy="14" r="5" fill="white"/>
          </svg>`,
            iconSize: [28, 40],
            iconAnchor: [14, 40],
            popupAnchor: [0, -40],
            className: "",
          });

          L.marker([lat, lng], { icon: rodePin })
            .addTo(map)
            .bindPopup(naam)
            .openPopup();

          map.invalidateSize();
        });

        // Printknop
        document.getElementById("print-knop")?.addEventListener("click", () => {
          window.print();
        });

        // Deel knop — Web Share API met fallback naar kopiëren
        // Bron: https://developer.mozilla.org/en-US/docs/Web/API/Navigator/share
        document
          .getElementById("deel-knop")
          ?.addEventListener("click", async () => {
            const deelData = {
              title: document.title,
              url: window.location.href,
            };
            if (navigator.share) {
              try {
                await navigator.share(deelData);
              } catch {
                // gebruiker annuleerde het delen
              }
            } else {
              await navigator.clipboard.writeText(window.location.href);
              const knop = document.getElementById("deel-knop");
              if (knop) {
                knop.textContent = "Link gekopieerd!";
                setTimeout(() => {
                  knop.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="2"/><path d="M8.59 13.51L15.42 17.49M15.41 6.51L8.59 10.49" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Delen`;
                }, 2000);
              }
            }
          });
      </script>
    </div>
  </body>

  <style>
    body {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    a {
      text-decoration: none;
    }
    .split-view {
      display: flex;
      flex-direction: column;
      flex: 1;
      overflow: hidden;
    }

    .info-panel {
      display: flex;
      flex-direction: column;
      gap: 0;
      overflow-y: auto;
      padding-bottom: 1rem;
    }

    a.back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: var(--ams-font-size-body-small);
      color: var(--ams-color-grey-5);
      padding: 16px 16px 8px;
    }

    a.back:hover {
      color: var(--ams-color-primair-red);
    }

    .location-information {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin: 8px 16px 16px;
      padding-left: 12px;
      border-left: 3px solid var(--ams-color-primair-red);
    }

    p.category {
      font-size: var(--ams-font-size-body-small);
      color: var(--ams-color-primair-red);
      text-transform: uppercase;
      font-weight: bold;
      margin: 0;
    }

    h2 {
      font-size: clamp(1.1rem, 3vw, 1.5rem);
      margin: 4px 0;
      line-height: 1.2;
    }

    p.adres {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: var(--ams-font-size-body-small);
      color: var(--ams-color-grey-4);
      margin: 0;
    }

    .toegankelijkheid {
      padding: 0 16px;
    }

    h3 {
      font-size: 1rem;
      font-weight: var(--ams-font-weight-semibold);
      padding: 16px 0;
    }

    .toegankelijkheid-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    @media (min-width: 480px) {
      .toegankelijkheid-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .toegankelijkheid-grid li {
      display: grid;
      grid-template-columns: 16px 1fr;
      align-items: center;
      gap: 10px;
      padding: 12px;
      height: 100%;
      border: 0.5px solid;
      font-size: var(--ams-font-size-body-small);
      border-radius: 4px;
      line-height: 1.4;
    }

    .item-ja {
      color: var(--ams-color-green-dark);
      background-color: #edf7f1;
      border-color: var(--ams-color-green-dark);
    }

    .item-nee {
      color: var(--ams-color-primair-red-dark);
      background-color: #fbeaea;
      border-color: var(--ams-color-primair-red-dark);
    }

    .item-onbekend {
      color: var(--ams-color-grey-3);
      background-color: var(--ams-color-grey-1);
      border-color: var(--ams-color-grey-2);
    }

    /* ── Printen / delen ── */
    .acties {
      display: flex;
      gap: 10px;
      padding: 16px 16px 0;
    }

    .actie {
      display: flex;
      gap: 10px;
      padding: 16px;
    }

    .actie-knop {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 16px;
      border: 1.5px solid var(--ams-color-grey-3);
      background: var(--ams-color-white);
      color: var(--ams-color-grey-5);
      font-family: var(--ams-font-family);
      font-size: var(--ams-font-size-body-small);
      font-weight: var(--ams-font-weight-semibold);
      cursor: pointer;
      border-radius: 6px;
      transition: background-color 0.15s ease;
      flex: 1;
      justify-content: center;
    }

    .actie-knop:hover {
      background-color: var(--ams-color-grey-1);
    }

    .actie-knop-rood {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 16px;
      border: 1.5px solid var(--ams-color-primair-red);
      background: var(--ams-color-primair-red);
      color: var(--ams-color-white);
      font-family: var(--ams-font-family);
      font-size: var(--ams-font-size-body-small);
      font-weight: var(--ams-font-weight-semibold);
      cursor: pointer;
      border-radius: 6px;
      transition: background-color 0.15s ease;
      flex: 1;
      justify-content: center;
    }

    .actie-knop-rood:hover {
      background-color: var(--ams-color-primair-red-dark);
    }

    /* ── Kaart paneel ── */
    .map-panel {
      flex-shrink: 0;
      height: 40vh;
    }

    #map {
      width: 100%;
      height: 100%;
    }

    /* ── Desktop ── */
    @media (min-width: 768px) {
      .split-view {
        flex-direction: row;
        overflow: hidden;
      }

      .info-panel {
        width: clamp(300px, 45%, 480px);
        flex-shrink: 0;
        border-right: 1px solid var(--ams-color-grey-2);
        overflow-y: auto;
      }

      .map-panel {
        flex: 1;
        height: auto;
      }

      #map {
        height: 100%;
      }
    }

    @media print {
      .acties,
      header,
      a.back {
        display: none;
      }

      .map-panel {
        height: 50vh;
      }
    }
  </style>
</html>
