---
//@ts-nocheck
const { locations } = Astro.props;

import DistanceDot from "../components/DistanceDot.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { lazy } from "astro:schema";
---

<link rel="stylesheet" href="styles/global.css" />

<section class="location-list">
  <ul>
    {
      locations.map((location) => (
        <li>
          <a href="">
            <div>
              <DistanceDot />
            </div>
            <div class="adres">
              <h2>{location.name}</h2>
              <p>
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M13.772 4.21855C15.9931 6.51565 15.9931 10.2198 13.772 12.5169L9.75017 16.6669L5.72827 12.5177C3.50724 10.2206 3.50724 6.51649 5.72827 4.21938C6.7917 3.11921 8.23952 2.50028 9.75 2.50012C11.2604 2.49996 12.7084 3.11861 13.772 4.21855Z"
                    stroke="#767676"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12.0249 8.00927C12.0101 9.2942 10.9851 10.3251 9.73232 10.315C8.4794 10.305 7.47025 9.25779 7.47512 7.97271C7.47998 6.68765 8.49698 5.64852 9.7499 5.64844C11.0137 5.65624 12.0321 6.7131 12.0249 8.00927Z"
                    stroke="#767676"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>

                {location.address}
              </p>
              <div class="badge">
                {/* <StatusBadge accessibility={accessibility} /> */}
                <StatusBadge />
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .location-list {
    margin: 16px;
  }

  .location-list ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .location-list li {
    border: solid 0.5px var(--ams-color-grey-3);
    padding: 12px 16px;
  }
  a {
    text-decoration: none;
    color: var(--ams-color-black);
    display: flex;
    gap: 2em;

    align-items: center;
  }

  .adres {
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .location-list li {
    list-style: none;
  }

  .adres p {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--ams-font-size-body-small);
    gap: 2px;
  }

  .adres .badge {
    margin-top: 6px;
  }
</style>
