---
const { id = "search-input", showButton = false } = Astro.props;
---

<div class="search-wrapper">
  <svg
    class="search-icon"
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill-rule="evenodd"
      clip-rule="evenodd"
      d="M4.40027 9.0123C4.40029 6.81199 5.95464 4.91812 8.11267 4.48894C10.2707 4.05977 12.4315 5.21483 13.2733 7.24772C14.1152 9.28062 13.4038 11.6251 11.5742 12.8473C9.74459 14.0696 7.30632 13.8292 5.75067 12.2731C4.886 11.4082 4.40025 10.2353 4.40027 9.0123Z"
      stroke="#767676"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M13.6233 13.6235L15.6001 15.6003"
      stroke="#767676"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <input
    id={id}
    placeholder="Zoek een gebouw of adres..."
    type="search"
    class="search-input"
  />
  <button class="clear-btn" aria-label="Wis zoekopdracht" style="display:none"
    >✕</button
  >
</div>

<style>
  @keyframes iconBounce {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.3) rotate(-8deg);
    }
    70% {
      transform: scale(0.9) rotate(4deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  .search-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      width: min(100%, max(30.8vw, 420px));
      transition: transform 0.25s ease;
  }

  .search-wrapper:focus-within {
    transform: translateY(-3px);
  }

  .search-icon {
    position: absolute;
    left: 14px;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .search-icon.bounce {
    animation: iconBounce 0.4s ease both;
  }

  .search-input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 44px;
    border-radius: 14px;
    border: none;
    outline: none;
    background-color: #ffffff;
    font-size: var(--ams-font-size-body);
    font-family: inherit;
    color: #111111;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    transition: box-shadow 0.25s ease;
  }

  .search-input::placeholder {
    color: var(--ams-color-grey-4);
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.15s ease;
  }

  .clear-btn:hover {
    background: rgba(0, 0, 0, 0.08);
  }

  /* verberg native browser-wis-knop */
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
  .search-input::-ms-clear {
    display: none;
  }

  .search-wrapper:focus-within .search-input {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
  }
</style>

<script>
  const input = document.querySelector(".search-input") as HTMLInputElement;
  const icon = document.querySelector(".search-icon") as SVGElement;
  const clearBtn = document.querySelector(".clear-btn") as HTMLButtonElement;

  if (input && icon) {
    let hasBounced = false;

    function updateClearBtn() {
      if (clearBtn)
        clearBtn.style.display = input.value.length > 0 ? "flex" : "none";
    }

    input.addEventListener("input", () => {
      if (!hasBounced && input.value.length > 0) {
        hasBounced = true;
        icon.classList.add("bounce");
        icon.addEventListener(
          "animationend",
          () => icon.classList.remove("bounce"),
          { once: true },
        );
      }
      if (input.value.length === 0) hasBounced = false;
      updateClearBtn();
    });

    clearBtn?.addEventListener("click", () => {
      input.value = "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });
  }
</script>
