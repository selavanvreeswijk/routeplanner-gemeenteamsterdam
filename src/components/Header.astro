<script is:inline>
  // Hoog contrast toggle (alleen in light mode) ---------------
  const popupContrastKnop = document.getElementById("popup-contrast-toggle");

  function stelContrastIn(aan) {
    document.body.classList.toggle("hoog-contrast", aan);
    localStorage.setItem("contrast", aan ? "hoog" : "normaal");
    popupContrastKnop.classList.toggle("actief-knop", aan);
  }

  // Dark mode toggle -----------------------------------------
  const popupDarkKnop = document.getElementById("popup-dark-toggle");

  function stelDarkModeIn(aan) {
    document.body.classList.toggle("dark-mode", aan);
    localStorage.setItem("darkmode", aan ? "aan" : "uit");
    popupDarkKnop.classList.toggle("actief-knop", aan);
    popupDarkKnop.querySelector(".dark-knop-tekst").textContent = aan
      ? "Light mode"
      : "Dark mode";
    // dark mode aan = contrast uit
    if (aan) stelContrastIn(false);
  }

  if (localStorage.getItem("darkmode") === "aan") {
    stelDarkModeIn(true);
  } else if (localStorage.getItem("contrast") === "hoog") {
    stelContrastIn(true);
  }

  popupContrastKnop.addEventListener("click", (e) => {
    e.stopPropagation();
    // contrast alleen aanzetten als dark mode uit is
    if (localStorage.getItem("darkmode") !== "aan") {
      stelContrastIn(!document.body.classList.contains("hoog-contrast"));
    }
  });

  popupDarkKnop.addEventListener("click", (e) => {
    e.stopPropagation();
    stelDarkModeIn(localStorage.getItem("darkmode") !== "aan");
  });

  // Naam tonen -----------------------------------------------
  const naam = localStorage.getItem("naam");
  const naamElement = document.getElementById("header-gebruiker-naam");
  const popupNaamElement = document.getElementById("popup-gebruiker-naam");
  if (naam) {
    if (naamElement) naamElement.textContent = `Hi, ${naam}`;
    if (popupNaamElement) popupNaamElement.textContent = `Hi, ${naam}`;
  }

  // Profielkaarten: inladen + opslaan in localStorage --------
  // Bron querySelectorAll + forEach: https://developer.mozilla.org/en-US/docs/Web/API/NodeList/forEach
  function laadProfiel() {
    const opgeslagen = JSON.parse(localStorage.getItem("profiel") || "{}");
    document.querySelectorAll('input[name="profiel-popup"]').forEach((cb) => {
      cb.checked = !!opgeslagen[cb.value];
    });
  }

  function slaProfielOp() {
    const profiel = {};
    document
      .querySelectorAll('input[name="profiel-popup"]:checked')
      .forEach((cb) => {
        profiel[cb.value] = true;
      });
    localStorage.setItem("profiel", JSON.stringify(profiel));
  }

  laadProfiel();

  document.querySelectorAll('input[name="profiel-popup"]').forEach((cb) => {
    cb.addEventListener("change", slaProfielOp);
  });

  // Profiel popup openen/sluiten --------------------------------
  // Bron addEventListener: https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/addEventListener
  const profielKnop = document.getElementById("profiel-knop");

  function openProfielPopup() {
    laadProfiel();
    document.getElementById("profiel-overlay").classList.add("actief");
    document.getElementById("profiel-popup").classList.add("actief");
    profielKnop.setAttribute("aria-expanded", "true");
  }

  function sluitProfielPopup() {
    document.getElementById("profiel-overlay").classList.remove("actief");
    document.getElementById("profiel-popup").classList.remove("actief");
    profielKnop.setAttribute("aria-expanded", "false");
    profielKnop.focus();
  }

  document
    .getElementById("profiel-knop")
    .addEventListener("click", openProfielPopup);
  document
    .getElementById("profiel-overlay")
    .addEventListener("click", sluitProfielPopup);
  document
    .getElementById("popup-sluit")
    .addEventListener("click", sluitProfielPopup);
</script>

<style>
  header {
    background-color: var(--ams-color-primair-red);
    padding: clamp(14px, 4vw, 24px) clamp(12px, 4vw, 20px)
      clamp(18px, 5vw, 28px);
    gap: clamp(10px, 3vw, 16px);
    display: flex;
    flex-direction: column;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .header-links {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header-links img {
    width: clamp(72px, 18vw, 120px);
    height: auto;
  }

  .gebruiker-rechts img {
    width: 25px;
    height: 25px;
  }

  h1 {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ams-color-white);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .header-top {
      position: static;
    }
    .header-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    h1 {
      position: static;
      transform: none;
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      pointer-events: auto;
    }
    :global(.search-wrapper) {
      width: clamp(340px, 38%, 500px);
    }
  }

  .gebruiker-rechts {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    padding: 0.5em 0.5em;
    border: 1px solid white;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.12);
    transition: background-color 0.15s ease;
    color: white;
    font-family: var(--ams-font-family);
    cursor: pointer;
  }

  .gebruiker-rechts:hover {
    background-color: rgba(255, 255, 255, 0.28);
  }

  .gebruiker-rechts:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .gebruiker-naam {
    color: var(--ams-color-white);
    font-size: clamp(0.75rem, 2.5vw, 0.875rem);
    font-weight: var(--ams-font-weight-semibold);
    flex-shrink: 0;
  }

  /* Overlay ------------------------------------------------- */
  #profiel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1000;
  }

  #profiel-overlay.actief {
    display: block;
  }

  /* Popup --------------------------------------------------- */
  /* Bron transform/transition: https://developer.mozilla.org/en-US/docs/Web/CSS/transform */
  #profiel-popup {
    position: fixed;
    top: 0;
    right: 0;
    width: 30%;
    min-width: 260px;
    height: 100%;
    background-color: var(--ams-color-white);
    z-index: 1001;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  #profiel-popup.actief {
    transform: translateX(0);
  }

  .profiel-top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    background-color: var(--ams-color-primair-red);
    padding: 2rem;
  }
  /* Terugknop — zelfde patroon als a.back op de detailpagina, maar wit */
  .popup-terug {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ams-font-family);
    font-weight: var(--ams-font-weight-semibold);
    color: var(--ams-color-white);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .popup-terug:hover {
    opacity: 0.8;
  }

  /* Begroeting */
  .popup-gebruiker {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

