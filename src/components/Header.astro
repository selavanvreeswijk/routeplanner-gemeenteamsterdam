---
import Searchfield from "./Searchfield.astro";
import Inputfield from "./Searchfield.astro";

// BASE_URL bevat het base-pad uit astro.config.mjs
// bijv. '/routeplanner-gemeenteamsterdam/'
// Dit is nodig om assets van de public folder correct in te laden
const { showSearch = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const logoUrl = `${baseUrl}assets/logo-gemeente-amsterdam.png`;
---

<header>
  <!-- Bovenste rij: logo + titels links, gebruikersnaam rechts -->
  <div class="header-top">
    <!-- Links: logo boven, "Atlass" eronder -->
    <div class="header-links">
      <img src={logoUrl} alt="Gemeente Amsterdam logo" />
      <h1>TAVI</h1>
    </div>

    <!-- Rechts: naam van de ingelogde gebruiker (ingevuld via script) -->
    <span id="header-gebruiker-naam" class="gebruiker-naam"></span>
  </div>

  <!-- Zoekbalk onder de titelbalk -->
  {showSearch && <Searchfield />}
</header>

<!-- Lees de naam op uit localStorage en zet hem in de header -->
<!-- localStorage werkt alleen client-side, vandaar een apart script -->
<!-- Bron localStorage: https://developer.mozilla.org/en-US/docs/Web/API/Window/localStorage -->
<script is:inline>
  const naam = localStorage.getItem("naam");
  const naamElement = document.getElementById("header-gebruiker-naam");
  if (naam && naamElement) {
    naamElement.textContent = `Hi, ${naam}`;
  }
</script>

<style>
  header {
    background-color: var(--ams-color-primair-red);
    padding: 20px 16px 24px;
    gap: 14px;
    display: flex;
    flex-direction: column;
  }

  /* Bovenste rij: logo-blok links, naam rechts */
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo boven, "Atlass" eronder */
  .header-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  header img {
    width: 48px;
    height: auto;
  }

  /* Tekst-stapel: "Gemeente Amsterdam" boven "Atlass" */
  .header-titels {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gemeente-label {
    color: var(--ams-color-white);
    font-size: var(--ams-font-size-body-extra-small);
    font-weight: var(--ams-font-weight-regular);
    opacity: 0.85;
    line-height: 1.2;
  }

  h1 {
    color: var(--ams-color-white);
    line-height: 1.2;
  }

  /* Naam van de gebruiker rechts in de header */
  .gebruiker-naam {
    color: var(--ams-color-white);
    font-size: var(--ams-font-size-body-small);
    font-weight: var(--ams-font-weight-semibold);
  }
</style>
