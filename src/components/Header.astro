---
import Inputfield from "./Inputfield.astro";
---

<header>
  <div>
    <img src="../public/assets/logo-gemeente-amsterdam.png" alt="" />
    <h1>Atlas</h1>
  </div>
  <Inputfield />
</header>

<style>
  header {
    background-color: var(--ams-color-red);
    padding: 20px 16px 24px;
    gap: 14px;
    display: flex;
    flex-direction: column;
  }

  header div {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  h1 {
    color: var(--ams-color-white);
  } 

  header img {
    width: 90px;
  }
</style>
