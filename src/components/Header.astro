---
import Searchfield from "./Searchfield.astro";
import Inputfield from "./Searchfield.astro";

// BASE_URL bevat het base-pad uit astro.config.mjs
// bijv. '/routeplanner-gemeenteamsterdam/'
// Dit is nodig om assets van de public folder correct in te laden
const baseUrl = import.meta.env.BASE_URL;
const logoUrl = `${baseUrl}assets/logo-gemeente-amsterdam.png`;
---

<header>
  <!-- Logo links, TAVI gecentreerd, gebruikersnaam rechts -->
  <div class="header-top">
    <div class="header-links">
      <img src={logoUrl} alt="Gemeente Amsterdam logo" />
    </div>

    <h1>TAVI</h1>

    <span id="header-gebruiker-naam" class="gebruiker-naam"></span>
  </div>

  <!-- Zoekbalk onder de titelbalk -->
  <Searchfield />
</header>

<!-- Lees de naam op uit localStorage en zet hem in de header -->
<!-- localStorage werkt alleen client-side, vandaar een apart script -->
<!-- Bron localStorage: https://developer.mozilla.org/en-US/docs/Web/API/Window/localStorage -->
<script>
  const naam = localStorage.getItem("naam");
  const naamElement = document.getElementById("header-gebruiker-naam");
  if (naam && naamElement) {
    naamElement.textContent = `Hi, ${naam}`;
  }
</script>

<style>
  header {
    background-color: var(--ams-color-primair-red);
    padding: clamp(14px, 4vw, 24px) clamp(12px, 4vw, 20px) clamp(18px, 5vw, 28px);
    gap: clamp(10px, 3vw, 16px);
    display: flex;
    flex-direction: column;
  }

  /* Logo links, TAVI absoluut gecentreerd, naam rechts */
  /* Bron absolute centering: https://developer.mozilla.org/en-US/docs/Web/CSS/position */
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .header-links {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  header img {
    width: clamp(36px, 10vw, 52px);
    height: auto;
  }

  /* TAVI absoluut gecentreerd ten opzichte van de volledige header-top breedte */
  h1 {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ams-color-white);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Naam van de gebruiker rechts in de header */
  .gebruiker-naam {
    color: var(--ams-color-white);
    font-size: clamp(0.75rem, 2.5vw, 0.875rem);
    font-weight: var(--ams-font-weight-semibold);
    flex-shrink: 0;
  }
</style>
