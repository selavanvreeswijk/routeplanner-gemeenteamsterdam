---
import Searchfield from "./Searchfield.astro";
import Inputfield from "./Searchfield.astro";

const { showSearch = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const logoUrl = `${baseUrl}assets/logo-gemeente-amsterdam.png`;
---

<header>
  <div class="header-top">
    <div class="header-links">
      <img src={logoUrl} alt="Gemeente Amsterdam logo" />
    </div>

    <h1>TAVI</h1>

    <!-- Gebruikersprofiel -->
    <div class="gebruiker-rechts">
      <span id="header-gebruiker-naam" class="gebruiker-naam"></span>
      <img src="./public/profile-icon.png" alt="Icoon voor een profiel">

      <!-- Contrast toggle -->
      <button id="contrast-toggle" aria-label="Hoog contrast aan/uit">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M4.4 10C4.4 6.9123 6.9123 4.4 10 4.4V15.6C6.9123 15.6 4.4 13.0877 4.4 10ZM10 3C6.1339 3 3 6.1339 3 10C3 13.8661 6.1339 17 10 17C13.8661 17 17 13.8661 17 10C17 6.1339 13.8661 3 10 3Z"
            fill="currentcolor"></path>
        </svg>
      </button>
    </div>
  </div>

  {showSearch && <Searchfield />}
</header>

<script is:inline>
  // Hoog contrast toggle -------------------------------------
  // Bron classList.toggle: https://developer.mozilla.org/en-US/docs/Web/API/Element/classList
  // Bron localStorage: https://developer.mozilla.org/en-US/docs/Web/API/Window/localStorage
  const contrastKnop = document.getElementById("contrast-toggle");

  if (localStorage.getItem("contrast") === "hoog") {
    document.body.classList.add("hoog-contrast");
    contrastKnop.setAttribute("aria-pressed", "true");
  }

  contrastKnop.addEventListener("click", () => {
    const aan = document.body.classList.toggle("hoog-contrast");
    localStorage.setItem("contrast", aan ? "hoog" : "normaal");
    contrastKnop.setAttribute("aria-pressed", aan ? "true" : "false");
  });

  const naam = localStorage.getItem("naam");
  const naamElement = document.getElementById("header-gebruiker-naam");
  if (naam && naamElement) {
    naamElement.textContent = `Hi, ${naam}`;
  }
</script>

<style>
  header {
    background-color: var(--ams-color-primair-red);
    padding: clamp(14px, 4vw, 24px) clamp(12px, 4vw, 20px)
      clamp(18px, 5vw, 28px);
    gap: clamp(10px, 3vw, 16px);
    display: flex;
    flex-direction: column;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .header-links {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  header img {
    width: clamp(36px, 10vw, 52px);
    height: auto;
  }

  h1 {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ams-color-white);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Responsiveness */
  @media (min-width: 1024px) {
    .header-top {
      position: static;
    }

    .header-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    h1 {
      position: static;
      transform: none;
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      pointer-events: auto;
    }

    :global(.search-wrapper) {
      width: clamp(340px, 38%, 500px);
    }
  }

  #contrast-toggle {
    display: none;
    
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    cursor: pointer;
  }

  #contrast-toggle[aria-pressed="true"] {
    background-color: none;
  }

  .gebruiker-rechts {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;

    padding: 0.1em 0.5em;
    border: 1px white;
    border-radius: 5px;

    border-style: dashed;
  }

  .gebruiker-rechts:hover {
    cursor: pointer;
  }

  .gebruiker-naam {
    color: var(--ams-color-white);
    font-size: clamp(0.75rem, 2.5vw, 0.875rem);
    font-weight: var(--ams-font-weight-semibold);
    flex-shrink: 0;
  }
</style>
