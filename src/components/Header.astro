---
import Searchfield from "./Searchfield.astro";
import Inputfield from "./Searchfield.astro";

const { showSearch = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const logoUrl = `${baseUrl}assets/logo-gemeente-amsterdam.png`;
---

<header>
  <div class="header-top">
    <div class="header-links">
      <img src={logoUrl} alt="Gemeente Amsterdam logo" />
    </div>

    <h1>TAVI</h1>

    <!-- Gebruikersprofiel -->
    <button class="gebruiker-rechts" id="profiel-knop" aria-label="Open profielmenu" aria-haspopup="dialog" aria-expanded="false">
      <span id="header-gebruiker-naam" class="gebruiker-naam"></span>
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M10.0599 10.39C10.0249 10.385 9.97987 10.385 9.93987 10.39C9.05988 10.36 8.35986 9.63999 8.35986 8.75499C8.35986 7.84999 9.08988 7.11499 9.99987 7.11499C10.9049 7.11499 11.6399 7.84999 11.6399 8.75499C11.6349 9.63999 10.9399 10.36 10.0599 10.39Z"
          stroke="currentColor"
          stroke-width="0.749998"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M13.3701 13.69C12.4801 14.505 11.3001 15 10.0001 15C8.70012 15 7.52012 14.505 6.63013 13.69C6.68013 13.22 6.98013 12.76 7.51512 12.4C8.88512 11.49 11.1251 11.49 12.4851 12.4C13.0201 12.76 13.3201 13.22 13.3701 13.69Z"
          stroke="currentColor"
          stroke-width="0.749998"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M9.99999 15C12.7614 15 15 12.7614 15 9.99999C15 7.23857 12.7614 5 9.99999 5C7.23857 5 5 7.23857 5 9.99999C5 12.7614 7.23857 15 9.99999 15Z"
          stroke="currentColor"
          stroke-width="0.749998"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  {showSearch && <Searchfield />}
</header>

<!-- Donkere overlay achter de popup -->
<div id="profiel-overlay"></div>

<!-- Profiel popup paneel (schuift in van rechts) -->
<div id="profiel-popup" role="dialog" aria-modal="true" aria-labelledby="popup-gebruiker-naam">
  <div class="profiel-top">
    <!-- Terugknop linksboven, zelfde stijl als a.back op de detailpagina -->
    <button id="popup-sluit" class="popup-terug">← Terug</button>

    <!-- Begroeting -->
    <p class="popup-naam" id="popup-gebruiker-naam">Hi</p>
    <p class="popup-subtitel">Wat wil je vandaag doen?</p>
  </div>

  <!-- Profielkaarten — exacte HTML + CSS overgenomen uit onboarding.astro -->
