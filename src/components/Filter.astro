<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

	.filters {
		display: flex;
		flex-wrap: nowrap;
		overflow-x: auto;
		gap: 8px;
		padding: 14px 16px;
		scrollbar-width: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 8px;
	}

	.filters::-webkit-scrollbar {
		display: none;
	}

	.filter-btn input[type="checkbox"] {
		display: none;
	}

	.filter-btn {
		padding: 10px 20px;

		border: 1.5px solid var(--ams-color-grey-3);
		background: var(--ams-color-grey-1);
		font-family: inherit;
		font-size: var(--p-small);
		color: var(--ams-color-grey-5);
		cursor: pointer;
		white-space: nowrap;
		align-items: center;
		display: flex;
		flex-direction: column;
		transition: all 0.18s ease;
	}

  .filter-btn:has(input:checked) {
    background-color: var(--ams-color-red);
    color: var(--ams-color-white);
    border-color: var(--ams-color-red);
    transform: scale(1.03);
  }

  .filter-btn:active {
    transform: scale(0.96);
  }

	.hidden-disability {
		display: none;
	}

	.hidden-disability.open {
		display: contents;
	}

  .hidden-disability.open .filter-btn:nth-child(1) {
    animation: fadeInUp 0.3s ease both 0s;
  }
  .hidden-disability.open .filter-btn:nth-child(2) {
    animation: fadeInUp 0.3s ease both 0.1s;
  }
  .hidden-disability.open .filter-btn:nth-child(3) {
    animation: fadeInUp 0.3s ease both 0.2s;
  }
  .hidden-disability.open .filter-btn:nth-child(4) {
    animation: fadeInUp 0.3s ease both 0.3s;
  }

  .bekijk-meer-wrapper {
    grid-column: 1 / -1;
    display: flex;
  }
  #bekijk-meer-btn {
    border: none;
    background: transparent;
    text-decoration: underline;
    color: var(--ams-color-black);
    font-weight: var(--ams-font-weight-semibold);
  }
</style>

<script>
	const btn = document.getElementById("bekijk-meer-btn");
	const hiddenDisability = document.getElementById("hidden-disability");

	if (btn && hiddenDisability) {
		btn.addEventListener("click", () => {
			hiddenDisability.classList.toggle("open");
			btn.textContent = hiddenDisability.classList.contains("open")
				? "bekijk Minder"
				: "bekijk Meer";
		});
	}

	const checkboxes = document.querySelectorAll('input[name="filter"]');

