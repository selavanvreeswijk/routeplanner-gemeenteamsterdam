---

<link rel="stylesheet" href="styles/global.css" />
<div class="input-wrapper">
  <svg
    class="search-icon"
    fill="var(--ams-color-grey-4)"
    width="20px"
    height="20px"
    viewBox="0 0 32 32"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M31.707 30.282l-9.717-9.776c1.811-2.169 2.902-4.96 2.902-8.007 0-6.904-5.596-12.5-12.5-12.5s-12.5 5.596-12.5 12.5 5.596 12.5 12.5 12.5c3.136 0 6.002-1.158 8.197-3.067l9.703 9.764c0.39 0.39 1.024 0.39 1.415 0s0.39-1.023 0-1.415zM12.393 23.016c-5.808 0-10.517-4.709-10.517-10.517s4.708-10.517 10.517-10.517c5.808 0 10.516 4.708 10.516 10.517s-4.709 10.517-10.517 10.517z"
    ></path>
  </svg>
  <input
    placeholder="Zoek een gebouw of adres..."
    type="text"
    name="text"
    class="input"
  />
</div>

<style>
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.search-icon {
  position: absolute;
  left: 14px;
  pointer-events: none;
  opacity: 0.45;
}

.input {
  width: 100%;
  height: 48px;
  padding: 0 16px 0 44px;
  border-radius: 14px;
  border: none;
  outline: none;
  background-color: var(--ams-color-grey-1);
  font-size: 16px;
  font-family: inherit;
  color: var(--ams-color-grey-5);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  transition: box-shadow 0.2s ease;
}

.input::placeholder {
  color: var(--ams-color-grey-4);
}

.input:focus {
  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.2);
}
</style>
