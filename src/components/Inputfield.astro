---

---

<link rel="stylesheet" href="styles/global.css" />
<div class="input-wrapper">
  <svg
    class="search-icon"
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill-rule="evenodd"
      clip-rule="evenodd"
      d="M4.40027 9.0123C4.40029 6.81199 5.95464 4.91812 8.11267 4.48894C10.2707 4.05977 12.4315 5.21483 13.2733 7.24772C14.1152 9.28062 13.4038 11.6251 11.5742 12.8473C9.74459 14.0696 7.30632 13.8292 5.75067 12.2731C4.886 11.4082 4.40025 10.2353 4.40027 9.0123Z"
      stroke="#767676"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M13.6233 13.6235L15.6001 15.6003"
      stroke="#767676"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <input
    id="search-input"
    placeholder="Zoek een gebouw of adres..."
    type="search"
    name="text"
    class="input"
  />
</div>

<style>
  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    pointer-events: none;
    opacity: 0.45;
  }

  .input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 44px;
    border-radius: 14px;
    border: none;
    outline: none;
    background-color: var(--ams-color-white);
    font-size: var(--ams-font-size-body);
    color: var(--ams-color-black);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    transition: box-shadow 0.2s ease;
  }

  .input::placeholder {
    color: var(--ams-color-grey-4);
  }

  .input:focus {
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.2);
  }
</style>
