<fieldset>
    <legend>Welk profiel past bij u?</legend>
    <label>
        <input type="checkbox" name="route" value="rolstoel" checked/>
        <img src="/rolstoel-icon.svg" alt="" width="30" height="30"/>
        Rolstoelgebruiker
        <span>Brede paden, hellingbanen, lage stoepen</span>
    </label>
    <label>
        <input type="checkbox" name="route" value="mindervalide"/>
        <img src="/mindervalide-icon.svg" alt="" width="30" height="30"/>
        Mindervalide
        <span>Vlakke routes, banken om uit te rusten, korte loopafstanden</span>
    </label>
    <label>
        <input type="checkbox" name="route" value="tijdelijke-beperking"/>
        <img src="/tijdelijke-beperking-icon.svg" alt="" width="30" height="30"/>
        Tijdelijke beperking
        <span>Vermijd trappen, kies voor kortste routes, toegankelijk openbaar vervoer</span>
    </label>
    <label>
        <input type="checkbox" name="route" value="visuele-beperking"/>
        <img src="/visuele-beperking-icon.svg" alt="" width="30" height="30"/>
        Visuele beperking
        <span>Vermijd drukke gebieden, kies voor routes met duidelijke oriëntatiepunten</span>
    </label>
</fieldset>

<style>
    fieldset {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        padding: 1rem;
        border: none;
    }

    legend {
        font-weight: bold;
        margin: 0;
        font-size: 1rem;
        color: var(--neutral-60);
    }

    label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.5rem;
        font-size: 1rem;
        font-weight: bold;
        background-color: var(--neutral-0);
        border: 1px solid var(--neutral-20);
    }

    label span{
        font-size: 0.8rem;
        font-weight: normal;
    }

    input[type="checkbox"] {
        -webkit-appearance: none;
        appearance: none;
        margin: 0;
        padding: 0;
    }

    label:has(input:checked) {
        background-color: var(--neutral-100);
        border: 1px solid var(--neutral-100);
        color: var(--neutral-0);
    }
</style>