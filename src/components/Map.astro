---
// leaflet CSS wordt geladen via <link> in index.astro
---

<div id="map-view" style="display: none;">
  <div id="map"></div>
  <p id="foutmelding"></p>
</div>

<script is:inline>
  window.kaartGeinitialiseerd = false;
  window._markers = [];

  // SELA: Deze functie wordt aangeroepen als de gebruiker op "kaart" klikt of de pagina op desktop laadt.
  // We checken eerst of de kaart al bestaat — anders maken we hem twee keer aan en crasht hij.
  window.initialiseerKaart = function () {
    if (window.kaartGeinitialiseerd) {
      // SELA: invalidateSize zorgt dat Leaflet de kaart opnieuw opmeet, handig als hij eerst verborgen was
      window._kaart.invalidateSize();
      return;
    }
    window.kaartGeinitialiseerd = true;

    // SELA: We maken een Leaflet-kaart aan in het HTML-element met id="map"
    // setView([lat, lng], zoomniveau) — Amsterdam centrum als startpunt
    var kaart = L.map("map").setView([52.3676, 4.9041], 13);
    window._kaart = kaart;

    // SELA: We laden de OpenStreetMap-tegels als achtergrond van de kaart
    // Bron: https://leafletjs.com/reference.html#tilelayer
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(kaart);

    // Bron L.divIcon: https://leafletjs.com/reference.html#divicon
    var rodePin = L.divIcon({
      html: '<svg width="22" height="32" viewBox="0 0 28 40" xmlns="http://www.w3.org/2000/svg"><path d="M14 0C6.268 0 0 6.268 0 14c0 9.333 14 26 14 26S28 23.333 28 14C28 6.268 21.732 0 14 0z" fill="#EC0000" stroke="white" stroke-width="1.5"/><circle cx="14" cy="14" r="5" fill="white"/></svg>',
      iconSize: [22, 32],
      iconAnchor: [11, 32],
      popupAnchor: [0, -32],
      className: "",
    });

    // SELA: window._locaties is de lijst van alle locaties die vanuit index.astro is meegestuurd via een inline script
    var locaties = window._locaties || [];
    locaties.forEach(function (loc) {
      if (!loc.lat || !loc.lng) return;
      // SELA: We controleren of de locatiekaart in de lijst verborgen is (door een filter of zoekopdracht)
      // Als de kaart verborgen is, plaatsen we ook geen marker op de kaart
      //CSS.escape: https://developer.mozilla.org/en-US/docs/Web/API/CSS/escape_static -> om ervoor te zorgen dat alle data-names geselecteerd kunnen worden
      const locName = document.querySelector('[data-name="' + CSS.escape(loc.name.toLowerCase()) + '"]');
      if (locName && locName.style.display==='none') return;
      // SELA: We maken een URL-vriendelijke slug van de naam (spaties → streepjes, speciale tekens weg)
      // Zo kunnen we linken naar de detailpagina van die locatie
      var slug = loc.name.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");
      var marker = L.marker([loc.lat, loc.lng], { icon: rodePin })
        .addTo(kaart)
        .bindPopup(
          "<strong>" + loc.name + "</strong><br>" + loc.address +
          "<br><a href='/locaties/" + slug + "' style='display:inline-block;margin-top:8px;color:#EC0000;font-weight:600;text-decoration:none;'>Bekijk locatie →</a>"
        );
      // SELA: We slaan de naam en het adres op in de marker zelf,
      // zodat we later kunnen filteren welke markers zichtbaar moeten zijn
      marker._locatieNaam = loc.name.toLowerCase();
      marker._locatieAdres = loc.address.toLowerCase();
      marker._naam = loc.name;
      marker._adres = loc.address;
      window._markers.push(marker);
    });

    // Blauw locatie-icoon
    // Bron L.divIcon: https://leafletjs.com/reference.html#divicon
    var icoonLocatie = L.divIcon({
      html: '<div class="locatie-icoon"><div class="locatie-ping"></div></div>',
      iconSize: [20, 20],
      iconAnchor: [10, 10],
      className: "",
    });

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        function (positie) {
          var lat = positie.coords.latitude;
          var lng = positie.coords.longitude;
          kaart.setView([lat, lng], 16);
          // Marker
          L.marker([lat, lng], { icon: icoonLocatie })
            .addTo(kaart)
            .bindPopup("Jouw huidige locatie")
            .openPopup();
        },
        function (error) {
          if (!foutmelding) return;
          switch (error.code) {
            case error.PERMISSION_DENIED:
              foutmelding.textContent =
                "Locatietoegang geweigerd. Sta locatie toe in je browserinstellingen.";
              break;
            case error.POSITION_UNAVAILABLE:
              foutmelding.textContent =
                "Locatiegegevens zijn momenteel niet beschikbaar.";
              break;
            case error.TIMEOUT:
              foutmelding.textContent =
                "Het opvragen van je locatie duurde te lang.";
              break;
            default:
              foutmelding.textContent =
                "Er is een onbekende fout opgetreden bij het ophalen van je locatie.";
          }
        },
      );
    } else {
      if (foutmelding)
        foutmelding.textContent =
          "Geolocation wordt niet ondersteund door deze browser.";
    }
  };

  // SELA: Deze functie synchroniseert de kaartmarkers met de zichtbare kaarten in de lijst.
  // Als een locatie gefilterd/gezocht is uit de lijst, verdwijnt de marker ook van de kaart.
  window.filterMarkers = function() {
    // SELA: We maken een Set van alle namen van locaties die nu zichtbaar zijn in de lijst
    // Een Set is sneller om in te zoeken dan een array
    const shownMarkers = new Set(
      [...document.querySelectorAll('.location-list li')]
      .filter(li => li.style.display !== 'none')
      .map(li => li.dataset.name)
    )

    // SELA: Voor elke marker op de kaart checken we of de bijbehorende locatie zichtbaar is
    // Zo niet, verwijderen we de marker van de kaart. Zo wel, voegen we hem toe (als hij er nog niet op staat)
    window._markers.forEach(function(marker) {
      const name = marker._locatieNaam
      if(shownMarkers.has(name)) {
          if (!window._kaart.hasLayer(marker)) marker.addTo(window._kaart);
      } else {
        if (window._kaart.hasLayer(marker)) window._kaart.removeLayer(marker);
      }
    })
  }

  var zoekMarker = null;

  // SELA: Deze functie zoekt een adres op via de Nominatim-API (gratis geocoding van OpenStreetMap)
  // en beweegt de kaart naar die locatie. Wordt aangeroepen als de gebruiker op Enter drukt of op de zoekknop klikt in kaartmodus.
  window.zoekOpKaart = async function (zoekterm) {
    if (!zoekterm || !window._kaart) return;

    // SELA: We sturen een verzoek naar Nominatim met de zoekterm, beperkt tot Nederland (countrycodes=nl)
    // encodeURIComponent zorgt dat spaties en speciale tekens veilig in de URL staan
    var response = await fetch(
      "https://nominatim.openstreetmap.org/search?q=" +
        encodeURIComponent(zoekterm) +
        "&format=json&limit=1&countrycodes=nl",
    );
    var data = await response.json();
    if (data.length === 0) return;

    var lat = parseFloat(data[0].lat);
    var lng = parseFloat(data[0].lon);
    var naam = data[0].display_name;

    // SELA: Als er al een zoekmarker op de kaart staat, verwijderen we die eerst
    if (zoekMarker) window._kaart.removeLayer(zoekMarker);
    // SELA: We zetten de kaartweergave naar de gevonden locatie, ingezoomd op niveau 15
    window._kaart.setView([lat, lng], 15);

    var zoekPin = L.divIcon({
      html: '<svg width="22" height="32" viewBox="0 0 28 40" xmlns="http://www.w3.org/2000/svg"><path d="M14 0C6.268 0 0 6.268 0 14c0 9.333 14 26 14 26S28 23.333 28 14C28 6.268 21.732 0 14 0z" fill="#EC0000" stroke="white" stroke-width="1.5"/><circle cx="14" cy="14" r="5" fill="white"/></svg>',
      iconSize: [22, 32],
      iconAnchor: [11, 32],
      popupAnchor: [0, -32],
      className: "",
    });
    zoekMarker = L.marker([lat, lng], { icon: zoekPin })
      .addTo(window._kaart)
      .bindPopup(naam)
      .openPopup();
  };
</script>

<style>
  #map {
    height: 40vh;
    border-radius: 8px;
    margin: 16px;
    animation: fadeInUp 0.9s ease both;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  #foutmelding {
    color: red;
    padding: 1rem;
  }

  @media (min-width: 1024px) {
    #map-view {
      flex: 1;
      overflow: hidden;
    }

    #map {
      height: 100%;
      margin: 0;
      border-radius: 0;
    }
  }

  /* Bron: https://docs.astro.build/en/guides/styling/#global-styles */
  :global(.locatie-icoon) {
    width: 20px;
    height: 20px;
    background-color: #007aff;
    border: 3px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(0, 122, 255, 0.4);
    position: relative;
  }

  :global(.locatie-ping) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgba(0, 122, 255, 0.3);
    animation: ping 2s ease-out infinite;
  }

  @keyframes ping {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }
    100% {
      transform: translate(-50%, -50%) scale(3);
      opacity: 0;
    }
  }
</style>
