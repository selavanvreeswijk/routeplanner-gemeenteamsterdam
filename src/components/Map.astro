<div id="map-view" style="display: none;">
  <div id="map"></div>
  <p id="foutmelding"></p>
</div>

<script is:inline>
  window.kaartGeinitialiseerd = false;

  window.initialiseerKaart = function () {
    if (window.kaartGeinitialiseerd) {
      window._kaart.invalidateSize();
      return;
    }
    window.kaartGeinitialiseerd = true;

    var kaart = L.map("map").setView([52.3676, 4.9041], 13);
    window._kaart = kaart;

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(kaart);

    var foutmelding = document.getElementById("foutmelding");

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        function (positie) {
          var lat = positie.coords.latitude;
          var lng = positie.coords.longitude;
          kaart.setView([lat, lng], 16);
          L.marker([lat, lng])
            .addTo(kaart)
            .bindPopup("Jouw huidige locatie")
            .openPopup();
        },
        function (error) {
          if (!foutmelding) return;
          switch (error.code) {
            case error.PERMISSION_DENIED:
              foutmelding.textContent =
                "Locatietoegang geweigerd. Sta locatie toe in je browserinstellingen.";
              break;
            case error.POSITION_UNAVAILABLE:
              foutmelding.textContent =
                "Locatiegegevens zijn momenteel niet beschikbaar.";
              break;
            case error.TIMEOUT:
              foutmelding.textContent =
                "Het opvragen van je locatie duurde te lang.";
              break;
            default:
              foutmelding.textContent =
                "Er is een onbekende fout opgetreden bij het ophalen van je locatie.";
          }
        },
      );
    } else {
      if (foutmelding)
        foutmelding.textContent =
          "Geolocation wordt niet ondersteund door deze browser.";
    }
  };
</script>

<style>
  #map {
    height: calc(100vh - 140px);
    width: 100%;
    margin-top: 20px;
  }

  #foutmelding {
    color: red;
    padding: 1rem;
  }
</style>
