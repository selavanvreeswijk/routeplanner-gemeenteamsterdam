---
//@ts-nocheck

import data from "../cbadataset.json" with { type: "json" };

// FILTEREN OP LOCATIE
const hoofdfilters = [
  ...new Set(data.features.map((f) => f.properties.Hoofdfilter.trim())), // verwijdert duplicaten, en zet om naar een gewone array
].sort();
const subfilters = [
  ...new Set(data.features.map((f) => f.properties.Subfilter.trim())),
].sort(); // sorteert alfabetisch

// Maak een map van hoofdfilter -> subfilters
const subfiltersByHoofd = {};

data.features.forEach((f) => { // loopt over elke locatie in je GeoJSON dataset.
  const hoofd = f.properties.Hoofdfilter.trim();
  const sub = f.properties.Subfilter.trim();
  if (!subfiltersByHoofd[hoofd]) subfiltersByHoofd[hoofd] = new Set(); // duplicaten automatisch worden genegeerd 
  subfiltersByHoofd[hoofd].add(sub);
});
// Bron: Claude om de duplicaten te negeren 

// Zet Sets om naar gesorteerde arrays
Object.keys(subfiltersByHoofd).forEach((k) => {
  subfiltersByHoofd[k] = [...subfiltersByHoofd[k]].sort(); // pakt de sets en zet ze om naar arrays 
});
// Bron: Tijdens de workshop met Jad
---

<div class="filters">
  <select id="hoofdfilter-select">
    <option value="">Alle categorieën</option>
    {hoofdfilters.map((f) => <option value={f}>{f}</option>)}
    <!-- Opties voor hoofdfilters genereren bijvb <option value="f = Sport"> f = Sport</option>-->
  </select>

  <select id="subfilter-select" disabled>
    <option value="">Alle subcategorieën</option>
    {subfilters.map((f) => <option value={f}>{f}</option>)}
  </select>
</div>

<script define:vars={{ subfiltersByHoofd }}>
  // --- haalt filters op uit de LocationFilter component
  const hoofdSelect = document.getElementById("hoofdfilter-select");
  const subSelect = document.getElementById("subfilter-select");

  function updateSubfilters() {
    // Kijkt welke hoofdfilter gekozen is en zoekt de bijbehorende subfilters op uit de map.
    const gekozen = hoofdSelect.value;
    const subs = gekozen ? (subfiltersByHoofd[gekozen] ?? []) : []; //als er niks gevonden wordt, gebruik een lege array (fallback)

    subSelect.innerHTML = '<option value="">Alle subcategorieën</option>'; // laat zien dat alle subfilters 
    // Maakt voor elke subfilter een nieuwe <option> aan en voegt die toe.
    subs.forEach((sub) => {
      const opt = document.createElement("option");
      opt.value = sub;
      opt.textContent = sub;
      subSelect.appendChild(opt);
    });
    // Zet de subfilter uit als er geen hoofdfilter gekozen is.
    subSelect.disabled = !gekozen;
  }

  // Roept updateSubfilters aan zodra je een hoofdfilter kiest.
  hoofdSelect.addEventListener("change", updateSubfilters);
</script>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0rem 1rem;
  }

  select {
    padding: 10px 40px 10px 16px;
    border: 0.5px solid var(--ams-color-grey-3);
    font-family: var(--ams-font-family);
    font-weight: var(--ams-font-weight-semibold);
    color: var(--ams-color-grey-5);
    cursor: pointer;
    border-radius: 6px;
    flex: 1;
  }

  body.dark-mode select {
    border: 0.5px solid var(--ams-color-grey-3);
    background-color: var(--ams-color-grey-1);
    color: var(--ams-color-grey-5);
  }

  select:focus {
    outline: none;
    border-color: var(--ams-color-primair-red-dark);
  }

  select:disabled {
    /* opacity: 0.4;
    cursor: not-allowed; */
    display: none;
  }

  @media (min-width: 550px) {
    .filters {
      flex-direction: row;
    }
  }
</style>
