---
// @ts-nocheck
const { counts } = Astro.props;

const labelMap = { // geeft namen aan de span classes in de LocationCard, zodat ze begrijpelijker zijn
  slechtterbeen: "Slecht ter been",
  rolstoel: "Rolstoel",
  slechtziend: "Slechtziend",
  slechthorend: "Slechthorend",
  prikkels: "Prikkels",
  hiddendisability: "Hidden disability",
};

// Deze functie geeft terug welke toegankelijkheidscategorieën een locatie "actief" heeft
// (dus waarvoor de locatie minstens één "Ja" heeft in de JSON-data)
// Hierna worden de badges op locatiekaarten getoond
function getActiveCategories(counts) {
  return Object.keys(counts).filter(
    (group) => group !== "algemeen" && counts[group]?.Ja > 0
  );
}

const activeCategories = getActiveCategories(counts);
