<style>
  .access-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .access-icon {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 2px 12px;
    border-radius: 999px;
  }

  .access-icon span {
    font-size: var(--ams-font-size-body-small);
    font-weight: 600;
  }

  .access-icon--rolstoel {
    background-color: var(--ams-color-green-light);
    border: 0.5px solid var(--ams-color-green-dark);
    color: var(--ams-color-green-dark);
  }
  .access-icon--slechtterbeen {
    background-color: var(--ams-color-blue-light);
    border: 0.5px solid var(--ams-color-blue);
    color: var(--ams-color-blue);
  }
  .access-icon--slechtziend {
    background-color: var(--ams-color-pink-light);
    border: 0.5px solid var(--ams-color-pink-dark);
    color: var(--ams-color-pink-dark);
  }
  .access-icon--slechthorend {
    background-color: var(--ams-color-orange-light);
    border: 0.5px solid var(--ams-color-orange-dark);
    color: var(--ams-color-orange-dark);
  }
  .access-icon--hiddendisability {
    background-color: var(--ams-color-light-blue-light);
    border: 0.5px solid var(--ams-color-light-blue-dark);
    color: var(--ams-color-light-blue-dark);
  }
  .access-icon--prikkels {
    background-color: var(--ams-color-purple-light);
    border: 0.5px solid var(--ams-color-purple-dark);
    color: var(--ams-color-purple-dark);
  }

  :global(body.dark-mode) .access-icon--rolstoel {
    background-color: var(--ams-color-green-dark);
    color: var(--ams-color-green-light);
  }
  :global(body.dark-mode) .access-icon--slechtterbeen {
    background-color: var(--ams-color-blue);
    color: var(--ams-color-blue-light);
  }
  :global(body.dark-mode) .access-icon--slechtziend {
    background-color: var(--ams-color-pink-dark);
    color: var(--ams-color-pink-light);
  }
  :global(body.dark-mode) .access-icon--slechthorend {
    background-color: var(--ams-color-orange-dark);
    color: var(--ams-color-orange-light);
  }
  :global(body.dark-mode) .access-icon--hiddendisability {
    background-color: var(--ams-color-light-blue-dark);
    color: var(--ams-color-light-blue-light);
  }
  :global(body.dark-mode) .access-icon--prikkels {
    background-color: var(--ams-color-purple-dark);
    color: var(--ams-color-purple-light);
  }
</style>